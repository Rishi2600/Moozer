generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core schema). Better Auth generates the ids.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  hostedSpaces  Space[]
  memberships   SpaceMember[]
  addedSongs    QueueItem[]
  votes         Vote[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

// One row per sign-in method: "google", "github", or "credential" (email +
// password, with the scrypt hash in `password`).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// Short-lived tokens, e.g. password reset links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Spaces
// ---------------------------------------------------------------------------

// Stage 7 adds paused and scheduled.
enum SpaceStatus {
  live
  ended
}

// A listening room. Its URL (/s/<slug>) is also the invite link, so resetting
// the link changes the slug; members keep their membership. The join code is
// what people type from a TV. Both change together on reset.
// CHECKs in the migration: the name isn't blank, and endedAt is set exactly
// when the status is ended.
model Space {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(60)
  slug      String        @unique
  joinCode  String        @unique @db.Char(6)
  status    SpaceStatus   @default(live)
  hostId    String
  host      User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  members   SpaceMember[]
  queue     QueueItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  endedAt   DateTime?

  @@index([hostId, createdAt])
  @@map("space")
}

// Who has joined a space. The host is a member too.
model SpaceMember {
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@id([spaceId, userId])
  @@index([userId, lastSeenAt])
  @@map("space_member")
}

// ---------------------------------------------------------------------------
// Queue and votes
// ---------------------------------------------------------------------------

enum SongSource {
  youtube
  spotify
}

// queued -> playing -> played. Removing a queued song deletes the row.
enum QueueItemStatus {
  queued
  playing
  played
}

// A song in a space's queue. Partial unique indexes in the migration: at most
// one playing song per space, and a video can't be queued twice at once.
// CHECK: startedAt and finalVotes are set exactly once a song has started;
// anchorAt/pausedAtMs only on the playing song.
model QueueItem {
  id              String          @id @default(cuid())
  spaceId         String
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  addedById       String
  addedBy         User            @relation(fields: [addedById], references: [id], onDelete: Cascade)
  source          SongSource      @default(youtube)
  sourceId        String // YouTube video id
  title           String
  channel         String?
  thumbnailUrl    String
  durationSeconds Int?
  status          QueueItemStatus @default(queued)
  addedAt         DateTime        @default(now())
  startedAt       DateTime? // "Played at" in History
  finalVotes      Int? // vote count when it started playing
  // Playback position for the playing song, shared by every screen:
  // playing -> position = now - anchorAt; paused -> position = pausedAtMs.
  anchorAt        DateTime?
  pausedAtMs      Int?
  votes           Vote[]

  @@index([spaceId, status, addedAt])
  @@index([addedById])
  @@map("queue_item")
}

// One vote per person per song.
model Vote {
  queueItemId String
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([queueItemId, userId])
  @@index([userId])
  @@map("vote")
}
