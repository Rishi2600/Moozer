generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core schema). Better Auth generates the ids.
// ---------------------------------------------------------------------------

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  hostedSpaces  Space[]
  memberships   SpaceMember[]
  removedFrom   SpaceRemoval[]
  addedSongs    QueueItem[]
  votes         Vote[]
  boosts        Boost[]
  boostLedger   BoostLedger[]
  orders        PaymentOrder[]
  likedSongs    LikedSong[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

// One row per sign-in method: "google", "github", or "credential" (email +
// password, with the scrypt hash in `password`).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// Short-lived tokens, e.g. password reset links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Spaces
// ---------------------------------------------------------------------------

// live: music can play. paused: the host is on a break (nothing plays; people
// can still add and vote). scheduled: opens at scheduledFor (people can join
// and line up songs early). ended: read-only. Order matters: lists sort by it.
enum SpaceStatus {
  live
  paused
  scheduled
  ended
}

// A listening room. Its URL (/s/<slug>) is also the invite link, so resetting
// the link changes the slug; members keep their membership. The join code is
// what people type from a TV. Both change together on reset.
// isPublic lists the space on Discover. listeners is how many people have it
// open right now, written by the realtime server (0 when it's down).
// CHECKs in the migrations: the name and description aren't blank, listeners
// isn't negative, and endedAt / pausedAt / scheduledFor are set exactly when
// the status is ended / paused / scheduled.
model Space {
  id           String         @id @default(cuid())
  name         String         @db.VarChar(60)
  description  String?        @db.VarChar(80)
  slug         String         @unique
  joinCode     String         @unique @db.Char(6)
  status       SpaceStatus    @default(live)
  isPublic     Boolean        @default(false)
  listeners    Int            @default(0)
  hostId       String
  host         User           @relation(fields: [hostId], references: [id], onDelete: Cascade)
  members      SpaceMember[]
  removed      SpaceRemoval[]
  queue        QueueItem[]
  boosts       Boost[]
  boostLedger  BoostLedger[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  endedAt      DateTime?
  pausedAt     DateTime?
  scheduledFor DateTime?

  @@index([hostId, createdAt])
  @@index([status, isPublic])
  @@map("space")
}

// Who has joined a space. The host is a member too.
model SpaceMember {
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@id([spaceId, userId])
  @@index([userId, lastSeenAt])
  @@map("space_member")
}

// People the host removed from a space; they can't rejoin it.
model SpaceRemoval {
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([spaceId, userId])
  @@index([userId])
  @@map("space_removal")
}

// ---------------------------------------------------------------------------
// Queue and votes
// ---------------------------------------------------------------------------

enum SongSource {
  youtube
  spotify
}

// queued -> playing -> played. Removing a queued song deletes the row.
enum QueueItemStatus {
  queued
  playing
  played
}

// A song in a space's queue. Partial unique indexes in the migration: at most
// one playing song per space, and a video can't be queued twice at once.
// CHECK: startedAt and finalVotes are set exactly once a song has started;
// anchorAt/pausedAtMs only on the playing song.
model QueueItem {
  id              String          @id @default(cuid())
  spaceId         String
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  addedById       String
  addedBy         User            @relation(fields: [addedById], references: [id], onDelete: Cascade)
  source          SongSource      @default(youtube)
  sourceId        String // YouTube video id
  title           String
  channel         String?
  thumbnailUrl    String
  durationSeconds Int?
  status          QueueItemStatus @default(queued)
  addedAt         DateTime        @default(now())
  startedAt       DateTime? // "Played at" in History
  finalVotes      Int? // vote count when it started playing
  dedication      String?         @db.VarChar(60) // "For Sam's birthday", from whoever added it
  // Playback position for the playing song, shared by every screen:
  // playing -> position = now - anchorAt; paused -> position = pausedAtMs.
  anchorAt        DateTime?
  pausedAtMs      Int?
  votes           Vote[]
  boosts          Boost[]

  @@index([spaceId, status, addedAt])
  @@index([addedById])
  @@map("queue_item")
}

// One vote per person per song.
model Vote {
  queueItemId String
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([queueItemId, userId])
  @@index([userId])
  @@map("vote")
}

// A boost placed on a song: +3 to its votes, from whom. Paid for by a
// "spend" row in the boost wallet (boost_ledger). Deleting a boost refunds it
// (a database trigger), unless it's settled: its song started playing.
model Boost {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  queueItemId String
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  settled     Boolean   @default(false) // its song started playing: no refund
  createdAt   DateTime  @default(now())

  @@index([spaceId, userId, createdAt])
  @@index([queueItemId])
  @@index([userId])
  @@map("boost")
}

enum LedgerReason {
  refill // the free boost is back (5.5 hours after it was used)
  purchase // bought with money
  grant // given: a 100% coupon, or the dev script
  spend // placed on a song
  refund // its boost was deleted (see cause)
  reversal // money refunded after boosts were credited
}

enum RefundCause {
  undo
  song_removed
  person_removed
  space_ended
  unplayable
}

// Each person's boost wallet: one row per change, and the balance is the sum
// of delta. The free boost is tracked through usedFree (on spends and refunds)
// and refill rows, so its 5.5-hour timer knows when it was used. Only
// lib/boosts/wallet.ts writes here (plus the refund trigger), under a lock per
// person. seq orders rows written in the same transaction.
model BoostLedger {
  id        String       @id @default(cuid())
  seq       BigInt       @default(autoincrement())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    LedgerReason
  usedFree  Boolean      @default(false)
  cause     RefundCause?
  orderId   String? // the purchase or coupon order a credit came from
  order     PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Where it happened, kept after the boost or song is gone.
  boostId   String?
  spaceId   String?
  space     Space?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  songTitle String?
  createdAt DateTime     @default(now())

  @@index([userId, seq])
  @@index([spaceId])
  @@map("boost_ledger")
}

enum PaymentProvider {
  razorpay
  coupon // a 100% code: no payment at all
}

enum OrderStatus {
  created
  paid
  failed
  refunded
}

enum CouponScope {
  all
  packs // not the single boost
}

// A discount code. Created and switched off with the coupon script; never
// deleted, so orders keep pointing at it.
model Coupon {
  id             String         @id @default(cuid())
  code           String         @unique // upper case
  percentOff     Int
  appliesTo      CouponScope    @default(all)
  active         Boolean        @default(true)
  maxRedemptions Int? // across everyone
  perUserLimit   Int?
  expiresAt      DateTime?
  note           String?
  createdAt      DateTime       @default(now())
  orders         PaymentOrder[]

  @@map("coupon")
}

// One attempt to get boosts: a Razorpay payment, or a code that made it free.
// The pack, count and amount are fixed when it's created. Kept when the
// account is deleted (userId cleared) as a record of the sale.
model PaymentOrder {
  id                String          @id @default(cuid())
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider          PaymentProvider
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  pack              String
  boosts            Int
  amountPaise       Int
  currency          String          @default("INR")
  couponId          String?
  coupon            Coupon?         @relation(fields: [couponId], references: [id], onDelete: Restrict)
  status            OrderStatus     @default(created)
  createdAt         DateTime        @default(now())
  paidAt            DateTime?
  ledger            BoostLedger[]

  @@index([userId, createdAt])
  @@index([couponId, userId])
  @@map("payment_order")
}

// A song someone saved with the heart, kept as it was (title, channel...) so
// the list survives the space and the queue item. Private to its owner.
model LikedSong {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          SongSource @default(youtube)
  sourceId        String // YouTube video id
  title           String
  channel         String?
  thumbnailUrl    String
  durationSeconds Int?
  likedAt         DateTime   @default(now())

  @@unique([userId, source, sourceId])
  @@index([userId, likedAt])
  @@map("liked_song")
}
