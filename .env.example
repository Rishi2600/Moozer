# Copy to .env at the repo root: cp .env.example .env
# Every app (web, realtime, db) reads this one file.

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://moozer:moozer@localhost:5432/moozer"

# Better Auth: the secret must be 32+ random characters (`openssl rand -base64 32`)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-me-with-32-or-more-random-characters"

# OAuth apps (callback: http://localhost:3000/api/auth/callback/<provider>)
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# Realtime WebSocket server (apps/realtime)
REALTIME_PORT=8080

# Signs the short tickets the website gives browsers for the realtime server.
# Same value for web and realtime; 32+ random characters (`openssl rand -base64 32`).
REALTIME_SECRET="replace-me-with-32-or-more-random-characters"
# Where browsers connect for live updates, and which site may connect.
NEXT_PUBLIC_REALTIME_URL="ws://localhost:8080"
WEB_ORIGIN="http://localhost:3000"

# YouTube Data API v3 key (optional): adds song durations. Without it, oEmbed is used.
YOUTUBE_API_KEY=""

# Razorpay (buying boosts). Test keys start with rzp_test_, live with rzp_live_;
# the names stay the same. Without the key pair, buying is off (codes still work).
# Dashboard -> Account & Settings -> API Keys. See docs: the webhook secret is
# one we make (`openssl rand -hex 32`) and type into the dashboard's webhook form.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
