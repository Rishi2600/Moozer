# Copy to .env at the repo root: cp .env.example .env
# Every app (web, realtime, db) reads this one file.

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://moozer:moozer@localhost:5432/moozer"

# Better Auth: the secret must be 32+ random characters (`openssl rand -base64 32`)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-me-with-32-or-more-random-characters"

# OAuth apps (callback: http://localhost:3000/api/auth/callback/<provider>)
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# Realtime WebSocket server (apps/realtime)
REALTIME_PORT=8080
